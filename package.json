{
  "name": "@phpsoftbox/pushr",
  "version": "3.0.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "test": "yarn test:lifecycle && yarn test:package",
    "test:lifecycle": "vitest run",
    "test:package": "node ./tests/package-smoke.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "prepack": "yarn clean && yarn build",
    "prepublishOnly": "yarn test"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "19.2.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
